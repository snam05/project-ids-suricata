# CHỈ LÀ VÍ DỤ LOCAL; chưa có VPS thực tế. Không chứa mật khẩu/token.
# Các script hiện CHƯA tự đọc file .env. TV2 chọn cách nạp có kiểm soát.
LAB_CLIENT_IP=10.10.10.10
LAB_SERVER_IP=10.10.10.20
LAB_CIDR=10.10.10.0/24
LAB_INTERFACE=REPLACE_WITH_PRIVATE_INTERFACE
LAB_CLIENT_SSH_USER=REPLACE_WITH_CLIENT_USER
SURICATA_CONFIG=/etc/suricata/suricata.yaml
# TV2 phải chốt đúng một phiên bản cho cả nhóm, ghi trong manifest.
SURICATA_VERSION=REPLACE_WITH_TEAM_PINNED_VERSION
